   "source": [
    "##  View result"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c172bf80",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "from sqlalchemy import create_engine\n",
    "\n",
    "# --- DB CONNECTION ---\n",
    "db_user = os.environ.get(\"POSTGRES_USER\", \"postgres\")\n",
    "db_password = os.environ.get(\"POSTGRES_PASSWORD\", \"mysecretpassword\")\n",
    "db_host = os.environ.get(\"POSTGRES_HOST\", \"localhost\")\n",
    "db_port = os.environ.get(\"POSTGRES_PORT\", \"5432\")\n",
    "db_name = os.environ.get(\"POSTGRES_DB\", \"nepobaby\")\n",
    "\n",
    "DATABASE_URL = f\"postgresql://{db_user}:{db_password}@{db_host}:{db_port}/{db_name}\"\n",
    "engine = create_engine(DATABASE_URL)\n",
    "\n",
    "# --- Ask user for personid ---\n",
    "person_id = input(\"Enter personid to query relatives: \")\n",
    "\n",
    "# --- Query using CTE and UNION ALL ---\n",
    "query = f\"\"\"\n",
    "WITH target_person AS (\n",
    "    SELECT * FROM person WHERE personid = '{person_id}'\n",
    "),\n",
    "related_influencer AS (\n",
    "    SELECT \n",
    "        t.personid,\n",
    "        t.name,\n",
    "        t.gender,\n",
    "        'self' AS relationship_name,\n",
    "        t.influencerid,\n",
    "        t.occupationid,\n",
    "        i.influence_score,\n",
    "        o.occupation_name\n",
    "    FROM target_person t\n",
    "    LEFT JOIN influencer i ON t.influencerid = i.influencerid\n",
    "    LEFT JOIN occupation o ON t.occupationid = o.occupationid\n",
    "\n",
    "    UNION ALL\n",
    "\n",
    "    SELECT \n",
    "        p.personid,\n",
    "        p.name,\n",
    "        p.gender,\n",
    "        r.relationship_name,\n",
    "        p.influencerid,\n",
    "        p.occupationid,\n",
    "        i.influence_score,\n",
    "        o.occupation_name\n",
    "    FROM relative rel\n",
    "    JOIN person p ON rel.relativeid = p.personid\n",
    "    JOIN relationship r ON rel.relationshipid = r.relationshipid\n",
    "    LEFT JOIN influencer i ON p.influencerid = i.influencerid\n",
    "    LEFT JOIN occupation o ON p.occupationid = o.occupationid\n",
    "    WHERE rel.personid = '{person_id}'\n",
    ")\n",
    "SELECT * \n",
    "FROM related_influencer\n",
    "ORDER BY influence_score DESC NULLS LAST;\n",
    "\"\"\"\n",
    "\n",
    "# --- Run query ---\n",
    "df = pd.read_sql(query, engine)\n",
    "\n",
    "# --- Display result ---\n",
    "print(\"\\n📌 Related influencer results:\")\n",
    "display(df)\n"
   ]
  },
