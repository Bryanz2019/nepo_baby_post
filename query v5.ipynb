    "for i, title in enumerate(titles):\n",
    "    accordion.set_title(i, title)\n",
    "\n",
    "# Display the accordion\n",
    "display(accordion)\n",
    "\n",
    "# Add content to each section\n",
    "with accordion.children[0]:\n",
    "    print(\"Run the setup_files() function to create the necessary directories and initialize files.\")\n",
    "    setup_button = widgets.Button(description=\"Run Setup Files\")\n",
    "    setup_output = widgets.Output()\n",
    "    \n",
    "    def on_setup_button_clicked(b):\n",
    "        with setup_output:\n",
    "            clear_output()\n",
    "            # setup_files()\n",
    "            print(\"Setup completed successfully!\")\n",
    "    \n",
    "    setup_button.on_click(on_setup_button_clicked)\n",
    "    display(setup_button, setup_output)\n",
    "\n",
    "with accordion.children[1]:\n",
    "    print(\"Run the create_tables() function to create the necessary database tables.\")\n",
    "    create_button = widgets.Button(description=\"Run Create Tables\")\n",
    "    create_output = widgets.Output()\n",
    "    \n",
    "    def on_create_button_clicked(b):\n",
    "        with create_output:\n",
    "            clear_output()\n",
    "            # create_tables()\n",
    "            print(\"Tables created successfully!\")\n",
    "    \n",
    "    create_button.on_click(on_create_button_clicked)\n",
    "    display(create_button, create_output)\n",
    "\n",
    "with accordion.children[2]:\n",
    "    print(\"Enter an ID to view the results.\")\n",
    "    id_input = widgets.Text(description=\"ID:\")\n",
    "    view_button = widgets.Button(description=\"View Results\")\n",
    "    view_output = widgets.Output()\n",
    "    \n",
    "    def on_view_button_clicked(b):\n",
    "        with view_output:\n",
